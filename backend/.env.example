# Copy to backend/.env for local dev, or set these in your shell / IDE run config.
# For secrets only on your machine, use backend/src/main/resources/application-dev.local.yml (gitignored).

SPRING_PROFILES_ACTIVE=prod

# Supabase PostgreSQL (JDBC format — include sslmode=require)
DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_supabase_db_password

# Auth — generate: openssl rand -base64 48
JWT_SECRET=your-256-bit-or-longer-secret-key

# Vercel frontend URL (no trailing slash)
CORS_ALLOWED_ORIGINS=https://srivari-ui.vercel.app,https://*.vercel.app,http://localhost:4200
SITE_FRONTEND_URL=https://srivari-ui.vercel.app
SITE_API_URL=https://srivari-1.onrender.com/api

# Cloudinary (Dashboard → Account Details)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email — Brevo HTTP API (recommended on Render; SMTP ports are blocked)
# Create API key: Brevo → SMTP & API → API Keys
# Verify sender email: Brevo → Senders & Domains
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=your-verified-sender@yourdomain.com
MAIL_ADMIN=quotes@yourdomain.com
MAIL_SENDER_NAME=Sri Vaari

# Optional local SMTP fallback (does not work on Render free tier)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
