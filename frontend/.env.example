# Vercel environment variables (Project → Settings → Environment Variables)

# Local dev: ng serve proxies /api/** → Render (proxy.conf.json). Restart ng serve after proxy changes.
# Vercel prod: vercel.json rewrites /api/* → Render (no CORS issues).
# Use relative URL so both environments proxy correctly:
API_URL=/api/v1
APP_NAME=Sri Vaari
APP_TAGLINE=Where Innovation Meets Reliability
WHATSAPP_PHONE=919876543210
